# =============================================
# FinX - Environment Variables Template
# Bu faylni .env deb nusxalab, haqiqiy qiymatlarni to'ldiring
# GitHub ga bu fayl yuklanadi (.env yuklanmaydi!)
# =============================================

# Django
SECRET_KEY=django-insecure-change-this-in-production-use-strong-random-key
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database
DB_NAME=finai
DB_USER=superuser
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP)
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

